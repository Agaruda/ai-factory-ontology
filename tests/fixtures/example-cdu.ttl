ai-factory-model:example-cdu-l2l-500.tcs-supply.temp-max
    a s223:QuantifiableProperty ;
    s223:hasAspect
        s223:Aspect-Maximum ,
        ai-factory:Aspect-Operating ;
    s223:hasValue 45.0 ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C ;
    prov:wasDerivedFrom
