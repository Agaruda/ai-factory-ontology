PREFIX ai-factory: <https://w3id.org/ai-factory#>
PREFIX ai-factory-model: <https://w3id.org/ai-factory/model/>
PREFIX ai-factory-org: <https://w3id.org/ai-factory/org/>
PREFIX ai-factory-source: <https://w3id.org/ai-factory/source/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rec: <https://w3id.org/rec#>
PREFIX s223: <http://data.ashrae.org/standard223#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ai-factory-model:example-mgmt-switch-48.function
    a ai-factory:NetworkPlaneFunctionProperty ;
    s223:hasEnumerationKind ai-factory:EnumerationKind-NetworkPlaneFunction ;
    s223:hasValue ai-factory:NetworkPlaneFunction-OutOfBandManagement ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=1" ;
                ] ;
            oa:hasSource ai-factory-source:example-mgmt-switch-48-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-mgmt-switch-48.mgmt
    a ai-factory:ManagementPort ;
    s223:hasMedium s223:WiredEthernet-1000BASE-T ;
    s223:isConnectionPointOf ai-factory-model:example-mgmt-switch-48 ;
.

ai-factory-model:example-mgmt-switch-48.power-in
    a ai-factory:PowerInlet ;
    s223:hasMedium ai-factory:AC-1Ph-50Hz-60Hz ;
    s223:hasProperty ai-factory-model:example-mgmt-switch-48.power-in.voltage-max ;
    s223:isConnectionPointOf ai-factory-model:example-mgmt-switch-48 ;
.

ai-factory-model:example-mgmt-switch-48.power-in.voltage-max
    a ai-factory:LineToNeutralVoltage ;
    s223:hasAspect
        s223:Aspect-Maximum ,
        ai-factory:Aspect-Required ;
    s223:hasValue 240.0 ;
    qudt:hasQuantityKind quantitykind:Voltage ;
    qudt:hasUnit unit:V ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=2" ;
                ] ;
            oa:hasSource ai-factory-source:example-mgmt-switch-48-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-mgmt-switch-48.rj45
    a ai-factory:DataPort ;
    s223:hasMedium s223:WiredEthernet-1000BASE-T ;
    s223:hasProperty
        ai-factory-model:example-mgmt-switch-48.rj45.count ,
        ai-factory-model:example-mgmt-switch-48.rj45.protocol ,
        ai-factory-model:example-mgmt-switch-48.rj45.rate-max ;
    s223:isConnectionPointOf ai-factory-model:example-mgmt-switch-48 ;
.

ai-factory-model:example-mgmt-switch-48.rj45.count
    a ai-factory:ConnectionPointCount ;
    s223:hasValue 48.0 ;
    qudt:hasQuantityKind quantitykind:Count ;
    qudt:hasUnit unit:NUM ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=1" ;
                ] ;
            oa:hasSource ai-factory-source:example-mgmt-switch-48-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-mgmt-switch-48.rj45.protocol
    a ai-factory:NetworkProtocolProperty ;
    s223:hasEnumerationKind ai-factory:EnumerationKind-NetworkProtocol ;
    s223:hasValue ai-factory:NetworkProtocol-Ethernet ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=1" ;
                ] ;
            oa:hasSource ai-factory-source:example-mgmt-switch-48-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-mgmt-switch-48.rj45.rate-max
    a ai-factory:PortDataRate ;
    s223:hasAspect s223:Aspect-Maximum ;
    s223:hasValue 1.0 ;
    qudt:hasQuantityKind quantitykind:DataRate ;
    qudt:hasUnit unit:GigaBIT-PER-SEC ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=1" ;
                ] ;
            oa:hasSource ai-factory-source:example-mgmt-switch-48-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-mgmt-switch-48
    a
        ai-factory:EthernetSwitch ,
        ai-factory:ProductModel ;
    rdfs:label "Example 48-port management switch"@en ;
    s223:hasConnectionPoint
        ai-factory-model:example-mgmt-switch-48.mgmt ,
        ai-factory-model:example-mgmt-switch-48.power-in ,
        ai-factory-model:example-mgmt-switch-48.rj45 ;
    s223:hasProperty ai-factory-model:example-mgmt-switch-48.function ;
    rec:manufacturedBy ai-factory-org:example-networks ;
    rec:modelNumber "MS-48" ;
.
