ai-factory-model:example-ib-switch-64.not-stated.cage-supply-voltage
    a ai-factory:NotStatedRecord ;
    ai-factory:aboutConnectionPointClass ai-factory:PluggableCage ;
    ai-factory:aboutModel ai-factory-model:example-ib-switch-64 ;
    ai-factory:aboutPropertyClass ai-factory:DCVoltage ;
    ai-factory:aboutQuantityKind quantitykind:Voltage ;
    ai-factory:checkedSource
        ai-factory-source:example-ib-switch-64-datasheet ,
        ai-factory-source:example-ib-switch-64-manual ;
.

ai-factory-model:qualification.example-ib-switch-64.example-osfp-800-sr8
    a ai-factory:Qualification ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSource ai-factory-source:example-validated-cables-page ;
            ai-factory:section "Validated transceivers" ;
        ] ;
    ai-factory:firmwareVersion "1.2.3" ;
    ai-factory:qualificationScope ai-factory:QualificationScope-ComponentPairing ;
    ai-factory:qualifiedBy ai-factory-org:example-networks ;
    ai-factory:qualifiedItem
        ai-factory-model:example-ib-switch-64 ,
        ai-factory-model:example-osfp-800-sr8 ;
.

ai-factory-model:example-ib-switch-64.mgmt
    a ai-factory:ManagementPort ;
    s223:hasMedium s223:WiredEthernet-1000BASE-T ;
    s223:isConnectionPointOf ai-factory-model:example-ib-switch-64 ;
.

ai-factory-model:example-ib-switch-64.port-osfp
    a ai-factory:PluggableCage ;
    s223:hasMedium ai-factory:Signal-InfiniBand ;
    s223:hasProperty
        ai-factory-model:example-ib-switch-64.port-osfp.form-factor ,
        ai-factory-model:example-ib-switch-64.port-osfp.ib-generation ,
        ai-factory-model:example-ib-switch-64.port-osfp.protocol ,
        ai-factory-model:example-ib-switch-64.port-osfp.rate-max ;
    s223:isConnectionPointOf ai-factory-model:example-ib-switch-64 ;
.

ai-factory-model:example-ib-switch-64.port-osfp.form-factor
    a ai-factory:PluggableFormFactorProperty ;
    s223:hasEnumerationKind ai-factory:EnumerationKind-PluggableFormFactor ;
    s223:hasValue ai-factory:PluggableFormFactor-OSFP ;
    prov:wasDerivedFrom
        [
            a oa:SpecificResource ;
            oa:hasSelector
                [
                    a oa:FragmentSelector ;
                    dcterms:conformsTo <http://tools.ietf.org/rfc/rfc3778> ;
                    rdf:value "page=1" ;
                ] ;
            oa:hasSource ai-factory-source:example-ib-switch-64-datasheet ;
        ] ;
    ai-factory:basis ai-factory:Basis-Stated ;
.

ai-factory-model:example-ib-switch-64.port-osfp.ib-generation
    a ai-factory:InfiniBandGenerationProperty ;
    s223:hasEnumerationKind ai-factory:EnumerationKind-InfiniBandGeneration ;
    s223:hasValue ai-factory:InfiniBandGeneration-NDR ;
