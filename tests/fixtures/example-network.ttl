ai-factory-model:example-ib-switch-64.port-osfp.rate-max
    a ai-factory:PortDataRate ;
    s223:hasAspect s223:Aspect-Maximum ;
    s223:hasValue 400.0 ;
    qudt:hasQuantityKind quantitykind:DataRate ;
    qudt:hasUnit unit:GigaBIT-PER-SEC ;
    prov:wasDerivedFrom
