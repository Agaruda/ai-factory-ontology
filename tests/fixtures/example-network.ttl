ai-factory-model:example-osfp-800-sr8
    a
        ai-factory:OpticalTransceiver ,
        ai-factory:ProductModel ;
    rdfs:label "Example OSFP 800G SR8 transceiver"@en ;
    s223:hasConnectionPoint
        ai-factory-model:example-osfp-800-sr8.fiber ,
        ai-factory-model:example-osfp-800-sr8.plug ;
    rec:manufacturedBy ai-factory-org:example-optics ;
    rec:modelNumber "OSFP-800-SR8" ;
.

ai-factory-model:example-ib-switch-64
    a
        ai-factory:InfiniBandSwitch ,
        ai-factory:ProductModel ;
    rdfs:label "Example 64-port InfiniBand switch"@en ;
    s223:hasConnectionPoint
        ai-factory-model:example-ib-switch-64.mgmt ,
        ai-factory-model:example-ib-switch-64.port-osfp ,
        ai-factory-model:example-ib-switch-64.power-in ;
    rec:manufacturedBy ai-factory-org:example-networks ;
    rec:modelNumber "IBS-64" ;
    rec:numberOfPorts 64 ;
.
