PREFIX ai-factory: <https://w3id.org/ai-factory#>
PREFIX brick: <https://brickschema.org/schema/Brick#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX oa: <http://www.w3.org/ns/oa#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<https://w3id.org/ai-factory>
    a owl:Ontology ;
    rdfs:label "AI Factory Ontology"@en ;
    dcterms:description "An extension of Brick and ASHRAE Standard 223 for AI data centers: GPU systems and the network, liquid-cooling and power equipment around them, with product specifications and compatibility rules."@en ;
    dcterms:title "AI Factory Ontology"@en ;
    owl:imports
        <http://data.ashrae.org/standard223/1.0/model/all> ,
        <https://brickschema.org/schema/1.4/Brick> ;
    owl:versionInfo "0.4.0" ;
.

ai-factory:ActiveRearDoorHeatExchanger
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Active rear-door heat exchanger"@en ;
    rdfs:comment "A rear-door heat exchanger with powered fans of its own that pull the rack's exhaust air through its coil."@en ;
    rdfs:subClassOf ai-factory:RearDoorHeatExchanger ;
    skos:definition "A rear-door heat exchanger with powered fans of its own that pull the rack's exhaust air through its coil."@en ;
.

ai-factory:AddInCardFormFactorProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Add-in card form factor property"@en ;
    rdfs:comment "An enumerated property naming the outline of an add-in card, on its host connector, or the outlines an expansion slot accepts."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the outline of an add-in card, on its host connector, or the outlines an expansion slot accepts."@en ;
.

ai-factory:AdiabaticCooler
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Adiabatic cooler"@en ;
    rdfs:comment "A dry cooler with wetted pads or sprays that pre-cool the incoming air by evaporation in hot weather, which needs a separate water supply besides the loop being cooled."@en ;
    rdfs:subClassOf ai-factory:DryCooler ;
    skos:definition "A dry cooler with wetted pads or sprays that pre-cool the incoming air by evaporation in hot weather, which needs a separate water supply besides the loop being cooled."@en ;
.

ai-factory:AirCooledChiller
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Air-cooled chiller"@en ;
    rdfs:comment "A chiller that rejects its condenser heat straight to outdoor air through its own coils and fans."@en ;
    rdfs:subClassOf
        brick:Air_Cooled_Chiller ,
        ai-factory:Chiller ;
    skos:definition "A chiller that rejects its condenser heat straight to outdoor air through its own coils and fans."@en ;
.

ai-factory:AirCooledCondenser
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Air-cooled condenser"@en ;
    rdfs:comment "An outdoor coil with fans, sold separately from the unit holding the compressor, that condenses that unit's refrigerant by passing its heat to ambient air."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:Condenser_Heat_Exchanger ;
    skos:definition "An outdoor coil with fans, sold separately from the unit holding the compressor, that condenses that unit's refrigerant by passing its heat to ambient air."@en ;
.

ai-factory:AirInlet
    a owl:Class ;
    rdfs:label "Air inlet"@en ;
    rdfs:comment "A point where air enters a device, such as the intake face of a server or the return of an air handler."@en ;
    rdfs:subClassOf s223:InletConnectionPoint ;
    skos:definition "A point where air enters a device, such as the intake face of a server or the return of an air handler."@en ;
.

ai-factory:AirOutlet
    a owl:Class ;
    rdfs:label "Air outlet"@en ;
    rdfs:comment "A point where air leaves a device, such as the exhaust face of a server or the supply of an air handler."@en ;
    rdfs:subClassOf s223:OutletConnectionPoint ;
    skos:definition "A point where air leaves a device, such as the exhaust face of a server or the supply of an air handler."@en ;
.

ai-factory:Alternator
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Alternator"@en ;
    rdfs:comment "The rotating electrical machine of a generator set that turns the shaft power of the engine into alternating-current output."@en ;
    rdfs:subClassOf
        s223:Generator ,
        brick:Electrical_Equipment ;
    skos:definition "The rotating electrical machine of a generator set that turns the shaft power of the engine into alternating-current output."@en ;
.

ai-factory:ApproachTemperatureDifference
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Approach temperature difference"@en ;
    rdfs:comment "The difference between the temperature a heat exchanger delivers on one side and the incoming temperature on the other side, used to rate CDU capacity."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The difference between the temperature a heat exchanger delivers on one side and the incoming temperature on the other side, used to rate CDU capacity."@en ;
.

ai-factory:AutomaticTransferSwitch
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Automatic transfer switch"@en ;
    rdfs:comment "A transfer switch with mechanical contacts that senses a failure of its preferred source and moves the load to the alternate source by itself."@en ;
    rdfs:subClassOf
        brick:Automatic_Transfer_Switch ,
        ai-factory:TransferSwitch ;
    skos:definition "A transfer switch with mechanical contacts that senses a failure of its preferred source and moves the load to the alternate source by itself."@en ;
.

ai-factory:AvailableExternalPressure
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Available external pressure"@en ;
    rdfs:comment "The pressure difference a pump or coolant distribution unit can still deliver across the external loop at a stated flow, after its own internal losses."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The pressure difference a pump or coolant distribution unit can still deliver across the external loop at a stated flow, after its own internal losses."@en ;
.

ai-factory:BackupRuntime
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Backup runtime"@en ;
    rdfs:comment "The time a battery, a battery backup unit or an uninterruptible power supply can carry a stated load from stored energy alone."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The time a battery, a battery backup unit or an uninterruptible power supply can carry a stated load from stored energy alone."@en ;
.

ai-factory:BasicImpulseLevel
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Basic impulse level"@en ;
    rdfs:comment "The peak voltage of a standard lightning impulse that the insulation of medium-voltage equipment withstands."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The peak voltage of a standard lightning impulse that the insulation of medium-voltage equipment withstands."@en ;
.

ai-factory:BatteryBackupUnit
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery backup unit"@en ;
    rdfs:comment "A battery module fitted in a power shelf or rack that carries the rack load for seconds to minutes and smooths fast load swings before they reach the facility supply."@en ;
    rdfs:subClassOf
        s223:Battery ,
        brick:Battery ;
    skos:definition "A battery module fitted in a power shelf or rack that carries the rack load for seconds to minutes and smooths fast load swings before they reach the facility supply."@en ;
.

ai-factory:BatteryCabinet
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery cabinet"@en ;
    rdfs:comment "A cabinet or open rack of rechargeable battery modules with its own disconnect and monitoring, sold as one unit to store direct-current energy for an uninterruptible power supply, an inverter or a direct-current bus."@en ;
    rdfs:subClassOf
        s223:Battery ,
        brick:Battery ;
    skos:definition "A cabinet or open rack of rechargeable battery modules with its own disconnect and monitoring, sold as one unit to store direct-current energy for an uninterruptible power supply, an inverter or a direct-current bus."@en ;
.

ai-factory:BatteryCell
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery cell"@en ;
    rdfs:comment "The smallest sealed electrochemical unit of a battery, combined with other cells into a module."@en ;
    rdfs:subClassOf
        s223:Battery ,
        brick:Battery ;
    skos:definition "The smallest sealed electrochemical unit of a battery, combined with other cells into a module."@en ;
.

ai-factory:BatteryChemistryProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery chemistry property"@en ;
    rdfs:comment "An enumerated property naming the cell chemistry of a battery cabinet, battery module, battery cell or battery backup unit."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the cell chemistry of a battery cabinet, battery module, battery cell or battery backup unit."@en ;
.

ai-factory:BatteryEnergyStorageSystem
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery energy storage system"@en ;
    rdfs:comment "A battery storage plant sold as one model, such as a containerized unit, that holds battery modules, thermal management and controls and exchanges energy with the grid or a facility bus through alternating-current or direct-current terminals."@en ;
    rdfs:subClassOf
        s223:Battery ,
        brick:Energy_Storage ;
    skos:closeMatch brick:Battery_Energy_Storage_System ;
    skos:definition "A battery storage plant sold as one model, such as a containerized unit, that holds battery modules, thermal management and controls and exchanges energy with the grid or a facility bus through alternating-current or direct-current terminals."@en ;
.

ai-factory:BatteryInverter
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery inverter"@en ;
    rdfs:comment "A bidirectional power conversion system that charges a battery from an alternating-current bus and discharges it back, converting between the direct current of the battery and alternating current."@en ;
    rdfs:subClassOf
        s223:ElectricEnergyInverter ,
        brick:Inverter ;
    skos:definition "A bidirectional power conversion system that charges a battery from an alternating-current bus and discharges it back, converting between the direct current of the battery and alternating current."@en ;
.

ai-factory:BatteryModule
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Battery module"@en ;
    rdfs:comment "A group of battery cells joined in series and parallel with their own monitoring, forming the replaceable building block of a battery cabinet or energy storage system."@en ;
    rdfs:subClassOf
        s223:Battery ,
        brick:Battery ;
    skos:definition "A group of battery cells joined in series and parallel with their own monitoring, forming the replaceable building block of a battery cabinet or energy storage system."@en ;
.

ai-factory:BidirectionalPowerPort
    a owl:Class ;
    rdfs:label "Bidirectional power port"@en ;
    rdfs:comment "A point through which electrical power flows either into or out of a device, such as a battery terminal or the grid terminal of a battery inverter."@en ;
    rdfs:subClassOf s223:BidirectionalConnectionPoint ;
    skos:definition "A point through which electrical power flows either into or out of a device, such as a battery terminal or the grid terminal of a battery inverter."@en ;
.

ai-factory:BreakerContinuousRatingProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Breaker continuous rating property"@en ;
    rdfs:comment "An enumerated property naming whether a circuit breaker is rated for continuous load at 80 or 100 percent of its rated current."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming whether a circuit breaker is rated for continuous load at 80 or 100 percent of its rated current."@en ;
.

ai-factory:Busway
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Busway"@en ;
    rdfs:comment "A prefabricated enclosed run of conductor bars, also called bus duct or busbar trunking, that carries power along a row or riser and lets tap-off units plug in at intervals to feed loads."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:Electrical_Equipment ;
    skos:definition "A prefabricated enclosed run of conductor bars, also called bus duct or busbar trunking, that carries power along a row or riser and lets tap-off units plug in at intervals to feed loads."@en ;
    skos:narrowMatch brick:Bus_Riser ;
.

ai-factory:BuswayTapOffUnit
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Busway tap-off unit"@en ;
    rdfs:comment "A plug-in unit that clamps onto a busway, takes power from its bars through its own breaker or fuse, and delivers it to a rack or power distribution unit through receptacles or a cable."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:Electrical_Equipment ;
    skos:definition "A plug-in unit that clamps onto a busway, takes power from its bars through its own breaker or fuse, and delivers it to a rack or power distribution unit through receptacles or a cable."@en ;
.

ai-factory:CDUControlModule
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coolant distribution unit control module"@en ;
    rdfs:comment "A coolant distribution unit module holding the controllers that run the pumps and valves of one or more pump modules and report to the building or data center management system."@en ;
    rdfs:subClassOf
        s223:Controller ,
        brick:Controller ,
        ai-factory:CDUModule ;
    skos:definition "A coolant distribution unit module holding the controllers that run the pumps and valves of one or more pump modules and report to the building or data center management system."@en ;
.

ai-factory:CDUHydronicsModule
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coolant distribution unit hydronics module"@en ;
    rdfs:comment "A coolant distribution unit module holding the expansion tank, make-up reservoir and fill pump that keep the technology cooling loop full and pressurized."@en ;
    rdfs:subClassOf ai-factory:CDUModule ;
    skos:definition "A coolant distribution unit module holding the expansion tank, make-up reservoir and fill pump that keep the technology cooling loop full and pressurized."@en ;
.

ai-factory:CDUPumpModule
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coolant distribution unit pump module"@en ;
    rdfs:comment "A coolant distribution unit module holding one or more circulation pumps for the technology cooling loop, often with its own strainer and flow meter."@en ;
    rdfs:subClassOf
        s223:Pump ,
        brick:Pump ,
        ai-factory:CDUModule ;
    skos:definition "A coolant distribution unit module holding one or more circulation pumps for the technology cooling loop, often with its own strainer and flow meter."@en ;
.

ai-factory:CPU
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Central processing unit"@en ;
    rdfs:comment "A central processing unit (CPU) package that runs the operating system and general-purpose work of a server, tray or superchip."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:ICT_Hardware ;
    skos:definition "A central processing unit (CPU) package that runs the operating system and general-purpose work of a server, tray or superchip."@en ;
.

ai-factory:CRAC
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Computer room air conditioner"@en ;
    rdfs:comment "A room air cooling unit for a data hall that cools air with its own refrigerant compressor circuit rather than with a chilled-water loop."@en ;
    rdfs:subClassOf
        s223:AirHandlingUnit ,
        brick:CRAC ;
    skos:definition "A room air cooling unit for a data hall that cools air with its own refrigerant compressor circuit rather than with a chilled-water loop."@en ;
.

ai-factory:CRAH
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Computer room air handler"@en ;
    rdfs:comment "A liquid-cooled air cooler with fans that serves a whole data hall, drawing warm room air over a chilled-water coil and returning it cooled, with no compressor of its own."@en ;
    rdfs:subClassOf
        s223:AirHandlingUnit ,
        brick:CRAH ,
        ai-factory:LiquidCooledAirCooler ;
    skos:definition "A liquid-cooled air cooler with fans that serves a whole data hall, drawing warm room air over a chilled-water coil and returning it cooled, with no compressor of its own."@en ;
.

ai-factory:CRAHFormProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Computer room air handler form property"@en ;
    rdfs:comment "An enumerated property naming the physical form of a computer room air handler."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the physical form of a computer room air handler."@en ;
.

ai-factory:CableAssemblyTechnologyProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cable assembly technology property"@en ;
    rdfs:comment "An enumerated property naming whether a pluggable cable assembly is passive copper, active copper or active optical."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming whether a pluggable cable assembly is passive copper, active copper or active optical."@en ;
.

ai-factory:CableLength
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cable length"@en ;
    rdfs:comment "The length of a cable assembly or fiber cable from end to end."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The length of a cable assembly or fiber cable from end to end."@en ;
.

ai-factory:CardHostConnector
    a owl:Class ;
    rdfs:label "Card host connector"@en ;
    rdfs:comment "The connector by which an add-in card such as a network adapter plugs into an expansion slot of its host, usually a card edge."@en ;
    rdfs:subClassOf s223:BidirectionalConnectionPoint ;
    skos:definition "The connector by which an add-in card such as a network adapter plugs into an expansion slot of its host, usually a card edge."@en ;
.

ai-factory:ChassisAirflowDirectionProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Chassis airflow direction property"@en ;
    rdfs:comment "An enumerated property naming the direction in which a piece of rack equipment moves cooling air."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the direction in which a piece of rack equipment moves cooling air."@en ;
.

ai-factory:CircuitBreaker
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Circuit breaker"@en ;
    rdfs:comment "A switching device that carries current in normal service, opens the circuit by itself on overcurrent or a fault, and can be closed again after it trips."@en ;
    rdfs:subClassOf
        s223:ElectricityBreaker ,
        brick:Circuit_Breaker ;
    skos:definition "A switching device that carries current in normal service, opens the circuit by itself on overcurrent or a fault, and can be closed again after it trips."@en ;
.

ai-factory:CircuitBreakerTypeProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Circuit breaker type property"@en ;
    rdfs:comment "An enumerated property naming the construction and interrupting technology of a circuit breaker."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the construction and interrupting technology of a circuit breaker."@en ;
.

ai-factory:ColdPlate
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cold plate"@en ;
    rdfs:comment "A metal plate with internal coolant channels mounted on a processor, accelerator or switch chip so that coolant flowing through it takes the chip's heat."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:Heat_Exchanger ;
    skos:definition "A metal plate with internal coolant channels mounted on a processor, accelerator or switch chip so that coolant flowing through it takes the chip's heat."@en ;
.

ai-factory:ComputeTray
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Compute tray"@en ;
    rdfs:comment "A server built as a tray to a shared mechanical design, which slides into a rack-scale system and draws power from the rack busbar."@en ;
    rdfs:subClassOf ai-factory:Server ;
    skos:definition "A server built as a tray to a shared mechanical design, which slides into a rack-scale system and draws power from the rack busbar."@en ;
.

ai-factory:ConnectionPointCount
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Connection point count"@en ;
    rdfs:comment "The number of identical connection points that one connection point record stands for, such as the receptacles of one type on a power distribution unit."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The number of identical connection points that one connection point record stands for, such as the receptacles of one type on a power distribution unit."@en ;
.

ai-factory:CoolantManifold
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coolant manifold"@en ;
    rdfs:comment "A header that splits one coolant line into many branch connections, or gathers many branches back into one line, for the trays and devices of a rack or a row."@en ;
    rdfs:subClassOf
        s223:Equipment ,
        brick:HVAC_Equipment ;
    skos:definition "A header that splits one coolant line into many branch connections, or gathers many branches back into one line, for the trays and devices of a rack or a row."@en ;
.

ai-factory:CoolantProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coolant property"@en ;
    rdfs:comment "An enumerated property of a liquid connection point naming one coolant the point takes, such as a 25 percent propylene glycol solution or water; a point that takes several coolants has one such property for each, and its medium is the most specific medium all of them are or are a kind of."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property of a liquid connection point naming one coolant the point takes, such as a 25 percent propylene glycol solution or water; a point that takes several coolants has one such property for each, and its medium is the most specific medium all of them are or are a kind of."@en ;
.

ai-factory:CoolingCapacity
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cooling capacity"@en ;
    rdfs:comment "The rate of heat a cooling device can remove under stated conditions."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The rate of heat a cooling device can remove under stated conditions."@en ;
.

ai-factory:CoolingMethodProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cooling method property"@en ;
    rdfs:comment "An enumerated property naming how a piece of IT equipment rejects its heat."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming how a piece of IT equipment rejects its heat."@en ;
.

ai-factory:CoolingPlacementProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cooling placement property"@en ;
    rdfs:comment "An enumerated property naming where a coolant distribution unit or coolant manifold sits relative to the racks it serves."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming where a coolant distribution unit or coolant manifold sits relative to the racks it serves."@en ;
.

ai-factory:CoolingTower
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cooling tower"@en ;
    rdfs:comment "A heat rejection unit that cools water toward the outdoor wet-bulb temperature by evaporating part of it into a stream of air."@en ;
    rdfs:subClassOf
        s223:CoolingTower ,
        brick:Cooling_Tower ;
    skos:definition "A heat rejection unit that cools water toward the outdoor wet-bulb temperature by evaporating part of it into a stream of air."@en ;
.

ai-factory:CoolingTowerCircuitProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Cooling tower circuit property"@en ;
    rdfs:comment "An enumerated property naming whether a cooling tower is open or closed circuit."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming whether a cooling tower is open or closed circuit."@en ;
.

ai-factory:CouplingGenderProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coupling gender property"@en ;
    rdfs:comment "An enumerated property naming which half of a quick-disconnect pair a liquid connection point is."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming which half of a quick-disconnect pair a liquid connection point is."@en ;
.

ai-factory:CouplingTypeProperty
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Coupling type property"@en ;
    rdfs:comment "An enumerated property naming the series and size of the quick-disconnect coupling at a liquid connection point."@en ;
    rdfs:subClassOf s223:EnumerableProperty ;
    skos:definition "An enumerated property naming the series and size of the quick-disconnect coupling at a liquid connection point."@en ;
.

ai-factory:DCPowerRack
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "DC power rack"@en ;
    rdfs:comment "A standalone rack or row-level power center that converts low-voltage alternating current from the facility into a direct-current bus, typically 800 V, and feeds it to the compute racks of one or more rows."@en ;
    rdfs:subClassOf
        s223:ElectricEnergyConverter ,
        brick:Electrical_Equipment ;
    skos:definition "A standalone rack or row-level power center that converts low-voltage alternating current from the facility into a direct-current bus, typically 800 V, and feeds it to the compute racks of one or more rows."@en ;
.

ai-factory:DCVoltage
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "DC voltage"@en ;
    rdfs:comment "The voltage of a direct-current supply or input."@en ;
    rdfs:subClassOf s223:QuantifiableProperty ;
    skos:definition "The voltage of a direct-current supply or input."@en ;
.

ai-factory:DPU
    a
        s223:Class ,
        owl:Class ;
    rdfs:label "Data processing unit"@en ;
    rdfs:comment "A network adapter with its own general-purpose processor cores and memory that runs networking, storage or security software apart from the host processors, and that is managed through its own management port."@en ;
    rdfs:subClassOf ai-factory:NetworkAdapter ;
    skos:definition "A network adapter with its own general-purpose processor cores and memory that runs networking, storage or security software apart from the host processors, and that is managed through its own management port."@en ;
.

ai-factory:DataConnectorProperty
    a
        s223:Class ,
