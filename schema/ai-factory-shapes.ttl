ai-factory:CouplingGenderPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-CouplingGender ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
