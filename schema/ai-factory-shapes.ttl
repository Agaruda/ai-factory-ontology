            sh:hasValue quantitykind:ElectricCurrent ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ;
    sh:targetClass ai-factory:ShortCircuitCurrentRating ;
.

ai-factory:SolidStateTransformerShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A solid-state transformer has a medium-voltage alternating-current power inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerInlet ;
                    sh:property
                        [
                            sh:class s223:Electricity-AC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A solid-state transformer has at least one direct-current power outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerOutlet ;
                    sh:property
                        [
                            sh:class s223:Electricity-DC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:SolidStateTransformer ;
.

