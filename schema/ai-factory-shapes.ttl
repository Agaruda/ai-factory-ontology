PREFIX ai-factory: <https://w3id.org/ai-factory#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX quantitykind: <http://qudt.org/vocab/quantitykind/>
PREFIX qudt: <http://qudt.org/schema/qudt/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX s223: <http://data.ashrae.org/standard223#>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX unit: <http://qudt.org/vocab/unit/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

ai-factory:ActiveRearDoorHeatExchangerShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "An active rear-door heat exchanger has at least one power inlet for its fans."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerInlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:ActiveRearDoorHeatExchanger ;
.

ai-factory:AddInCardFormFactorPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-AddInCardFormFactor ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:AddInCardFormFactorProperty ;
.

ai-factory:AdiabaticCoolerShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "An adiabatic cooler has an inlet for the process fluid and a separate water inlet for its pre-cooling pads or sprays."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 2 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:AdiabaticCooler ;
.

ai-factory:AirCooledChillerShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "An air-cooled chiller has at least one air discharge."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirOutlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "An air-cooled chiller has at least one air intake."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirInlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:AirCooledChiller ;
.

ai-factory:AirCooledCondenserShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "An air-cooled condenser has at least one refrigerant outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class s223:OutletConnectionPoint ;
                    sh:property
                        [
                            sh:class s223:Constituent-Refrigerant ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "An air-cooled condenser has at least one refrigerant inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class s223:InletConnectionPoint ;
                    sh:property
                        [
                            sh:class s223:Constituent-Refrigerant ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "An air-cooled condenser has at least one air discharge."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirOutlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "An air-cooled condenser has at least one air intake."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirInlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:AirCooledCondenser ;
.

ai-factory:ApproachTemperatureDifferenceShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:hasValue quantitykind:TemperatureDifference ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ,
        [
            sh:in (
                unit:K
                unit:DEG_C
            ) ;
            sh:path qudt:hasUnit ;
        ] ;
    sh:targetClass ai-factory:ApproachTemperatureDifference ;
.

ai-factory:AvailableExternalPressureShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:in (
                unit:KiloPA
                unit:BAR
                unit:PSI
                unit:M_H2O
                unit:FT_H2O
            ) ;
            sh:path qudt:hasUnit ;
        ] ,
        [
            sh:hasValue quantitykind:Pressure ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ;
    sh:targetClass ai-factory:AvailableExternalPressure ;
.

ai-factory:BackupRuntimeShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:hasValue quantitykind:Time ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ,
        [
            sh:in (
                unit:SEC
                unit:MIN
                unit:HR
            ) ;
            sh:path qudt:hasUnit ;
        ] ;
    sh:targetClass ai-factory:BackupRuntime ;
.

ai-factory:BasicImpulseLevelShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:in (
                unit:KiloV
            ) ;
            sh:path qudt:hasUnit ;
        ] ,
        [
            sh:hasValue quantitykind:Voltage ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ;
    sh:targetClass ai-factory:BasicImpulseLevel ;
.

ai-factory:BatteryCabinetShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A battery cabinet has at least one direct-current port through which it is charged and discharged."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:BidirectionalPowerPort ;
                    sh:property
                        [
                            sh:class s223:Electricity-DC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:BatteryCabinet ;
.

ai-factory:BatteryChemistryPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-BatteryChemistry ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:BatteryChemistryProperty ;
.

ai-factory:BatteryEnergyStorageSystemShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A battery energy storage system has at least one power port through which it is charged and discharged."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:BidirectionalPowerPort ;
                    sh:property
                        [
                            sh:class s223:Constituent-Electricity ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:BatteryEnergyStorageSystem ;
.

ai-factory:BatteryInverterShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A battery inverter has at least one alternating-current port on its grid side."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:BidirectionalPowerPort ;
                    sh:property
                        [
                            sh:class s223:Electricity-AC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A battery inverter has at least one direct-current port on its battery side."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:BidirectionalPowerPort ;
                    sh:property
                        [
                            sh:class s223:Electricity-DC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:BatteryInverter ;
.

ai-factory:BreakerContinuousRatingPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-BreakerContinuousRating ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:BreakerContinuousRatingProperty ;
.

ai-factory:BuswayShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A busway has at least one power outlet where a tap-off unit plugs in."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerOutlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A busway has at least one power inlet where its feeder is terminated."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerInlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:Busway ;
.

ai-factory:BuswayTapOffUnitShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A busway tap-off unit has at least one power outlet to the load it feeds."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerOutlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A busway tap-off unit has at least one power inlet that plugs into the busway."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerInlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:BuswayTapOffUnit ;
.

ai-factory:CDUControlModuleShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A coolant distribution unit control module has at least one data port for monitoring and control."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:DataPort ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CDUControlModule ;
.

ai-factory:CDUHydronicsModuleShape
    a sh:NodeShape ;
    sh:property
        [
            sh:message "A coolant distribution unit hydronics module has at least one connection to the secondary loop it keeps full."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class s223:BidirectionalConnectionPoint ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Secondary ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CDUHydronicsModule ;
.

ai-factory:CDUPumpModuleShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A coolant distribution unit pump module has at least one secondary coolant inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Secondary ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A coolant distribution unit pump module has at least one secondary coolant outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidOutlet ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Secondary ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CDUPumpModule ;
.

ai-factory:CRACShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A computer room air conditioner has at least one air intake."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirInlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A computer room air conditioner has at least one air discharge."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:AirOutlet ;
                    sh:property
                        [
                            sh:class s223:Fluid-Air ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CRAC ;
.

ai-factory:CRAHFormPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-CRAHForm ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:CRAHFormProperty ;
.

ai-factory:CableAssemblyTechnologyPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-CableAssemblyTechnology ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:CableAssemblyTechnologyProperty ;
.

ai-factory:CableLengthShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:in (
                unit:M
                unit:CentiM
                unit:FT
            ) ;
            sh:path qudt:hasUnit ;
        ] ,
        [
            sh:hasValue quantitykind:Length ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ;
    sh:targetClass ai-factory:CableLength ;
.

ai-factory:ChassisAirflowDirectionPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-ChassisAirflowDirection ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:ChassisAirflowDirectionProperty ;
.

ai-factory:ChillerShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A chiller has at least one chilled-water inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Evaporator ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A chiller has at least one chilled-water outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidOutlet ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Evaporator ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:Chiller ;
.

ai-factory:CircuitBreakerTypePropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-CircuitBreakerType ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
        ] ;
    sh:targetClass ai-factory:CircuitBreakerTypeProperty ;
.

ai-factory:ColdPlateShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A cold plate has at least one coolant outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidOutlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A cold plate has at least one coolant inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:ColdPlate ;
.

ai-factory:ComputeTrayShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A compute tray has pluggable cages on its network adapters for the scale-out and storage networks."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PluggableCage ;
                    sh:property
                        [
                            sh:class s223:Electricity-Signal ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A compute tray takes direct-current power from the rack busbar."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:PowerInlet ;
                    sh:property
                        [
                            sh:class s223:Electricity-DC ;
                            sh:path s223:hasMedium ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:ComputeTray ;
.

ai-factory:ConnectionPointCountShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:hasValue quantitykind:Count ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ,
        [
            sh:in (
                unit:NUM
            ) ;
            sh:path qudt:hasUnit ;
        ] ;
    sh:targetClass ai-factory:ConnectionPointCount ;
.

ai-factory:CoolantDistributionUnitShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A coolant distribution unit has at least one secondary return inlet that takes warm coolant back from the technology cooling loop."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                    sh:property 
                        [
                            sh:hasValue s223:Role-Return ;
                            sh:path s223:hasRole ;
                        ] ,
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Secondary ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A coolant distribution unit has at least one secondary supply outlet that sends coolant to the technology cooling loop."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidOutlet ;
                    sh:property 
                        [
                            sh:class s223:Fluid-Water ;
                            sh:path s223:hasMedium ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Secondary ;
                            sh:path s223:hasRole ;
                        ] ,
                        [
                            sh:hasValue s223:Role-Supply ;
                            sh:path s223:hasRole ;
                        ] ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CoolantDistributionUnit ;
.

ai-factory:CoolantManifoldShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:message "A coolant manifold has at least one coolant inlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidInlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:message "A coolant manifold has at least one coolant outlet."@en ;
            sh:path s223:hasConnectionPoint ;
            sh:qualifiedMinCount 1 ;
            sh:qualifiedValueShape
                [
                    sh:class ai-factory:LiquidOutlet ;
                ] ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass ai-factory:CoolantManifold ;
.

ai-factory:CoolingCapacityShape
    a sh:NodeShape ;
    sh:property 
        [
            sh:hasValue quantitykind:HeatFlowRate ;
            sh:maxCount 1 ;
            sh:path qudt:hasQuantityKind ;
        ] ,
        [
            sh:in (
                unit:W
                unit:KiloW
                unit:MegaW
            ) ;
            sh:path qudt:hasUnit ;
        ] ;
