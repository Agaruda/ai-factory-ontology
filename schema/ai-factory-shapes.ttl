ai-factory:CoolingTowerCircuitPropertyShape
    a sh:NodeShape ;
    sh:property
        [
            sh:hasValue ai-factory:EnumerationKind-CoolingTowerCircuit ;
            sh:maxCount 1 ;
            sh:path s223:hasEnumerationKind ;
